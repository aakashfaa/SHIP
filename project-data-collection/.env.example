# Supabase — project gfopaidnirrtyvfmgqwi
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. MUST NOT be prefixed NEXT_PUBLIC_.
# Only ever imported from app/api/**/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email (all auth email is sent by SHIP's server, never by Supabase -- D-6).
# See lib/email/send.ts and supabase/PREFLIGHT.md section 7.
# ---------------------------------------------------------------------------

# Resend API key (server-only, never NEXT_PUBLIC_). When unset, outside
# production, mail goes to the local Supabase Mailpit instead
# (http://127.0.0.1:55424), so every flow is testable on a laptop.
RESEND_API_KEY=

# Sender. Must be on a domain verified in Resend (SPF + DKIM), e.g.
#   EMAIL_FROM="Master Plan Dashboard <no-reply@ship.example.com>"
EMAIL_FROM=
# Optional: where replies go (otherwise replies go to EMAIL_FROM).
EMAIL_REPLY_TO=

# The public URL of this deployment, no trailing slash, e.g.
#   APP_URL=https://ship.example.com
# REQUIRED in production: every link in every email is built from it, never
# from the request's Host header (that would allow password-reset poisoning).
# Locally it may be left empty (falls back to the request origin).
APP_URL=

# Optional. Hours an emailed link stays valid, used only in the email copy.
# Must match Supabase Auth "Email OTP expiration" (otp_expiry). Default 24.
AUTH_LINK_EXPIRY_HOURS=

# Optional. Local mail catcher's HTTP API (default http://127.0.0.1:55424).
MAILPIT_URL=
