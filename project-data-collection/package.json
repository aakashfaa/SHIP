{
  "name": "project-data-collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/seed-local-users.mjs",
    "db:users": "node scripts/seed-local-users.mjs",
    "db:psql": "docker exec -it supabase_db_project-data-collection psql -U postgres -d postgres",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:parser": "node scripts/check-cost-parser-parity.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:all": "npm run typecheck && npm run test:unit && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
